;; The `babashka/fs` and `babashka/process` deps are the de-facto JVM
;; Clojure standard for filesystem and subprocess work — borkdude
;; libraries that happen to live under the babashka org but have no
;; runtime dependency on bb. We use them on JVM, not bb.
{:paths ["src" "resources"]
 :deps  {org.clojure/clojure              {:mvn/version "1.12.5"}
         org.clojure/core.async           {:mvn/version "1.9.865"}
         org.clojure/tools.cli            {:mvn/version "1.4.256"}
         babashka/fs                      {:mvn/version "0.5.34"}
         babashka/process                 {:mvn/version "0.6.25"}
         cheshire/cheshire                {:mvn/version "6.2.0"}
         clj-commons/clj-yaml             {:mvn/version "1.0.29"}
         hiccup/hiccup                    {:mvn/version "2.0.0"}
         http-kit/http-kit                {:mvn/version "2.8.1"}
         nrepl/nrepl                      {:mvn/version "1.7.0"}
         com.github.seancorfield/honeysql {:mvn/version "2.7.1437"}
         com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
         org.xerial/sqlite-jdbc           {:mvn/version "3.53.2.1"}}

 :aliases
 {:server
  {:main-opts ["-m" "cli.cch" "serve"]}

  :cli
  {:main-opts ["-m" "cli.cch"]}

  :test
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                 hato/hato {:mvn/version "1.0.0"}}
   ;; Redirect the event DB away from ~/.local/share/cch. Without this the
   ;; suite logs through the same path as live hooks and its fixtures are
   ;; indistinguishable from real events — 656 fake command-audit blocks
   ;; and `rm -rf /` x328 accumulated before anyone noticed. A property
   ;; rather than an env var because the JVM cannot set its own env, so
   ;; this holds however the tests are started.
   :jvm-opts    ["-Dcch.db.path=target/test-events.db"]
   :exec-fn     cognitect.test-runner.api/test
   :exec-args   {:dirs ["test"]}}

  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
   :ns-default build}

  :bench
  {:extra-paths ["bench"]
   :extra-deps  {criterium/criterium {:mvn/version "0.4.6"}
                 hato/hato           {:mvn/version "1.0.0"}}
   :main-opts   ["-m" "cch-bench"]}}}
